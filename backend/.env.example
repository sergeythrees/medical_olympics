# Copy to backend/.env (gitignored; read by the backend and by docker compose).
# LLM for POST /extract and `python -m evals.run`. The first one set wins.

# DeepSeek (OpenAI-compatible, JSON mode): https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Gemini via API key (https://aistudio.google.com/apikey) ...
GEMINI_API_KEY=
# ... or via Vertex AI: on GCP leave keys empty, set the project; the service account authenticates (ADC).
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=europe-west1
